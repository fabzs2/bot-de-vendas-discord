# ============================================================
# 🛒 CONFIGURAÇÃO DO BOT DE VENDAS DISCORD
# ============================================================

# Token do seu Bot criado no Discord Developer Portal (https://discord.com/developers)
# Lembre-se de ativar os 3 Privileged Gateway Intents (Presence, Server Members, Message Content)
DISCORD_TOKEN=seu_token_do_discord_aqui

# ID do cargo VIP padrão a ser entregue após a aprovação (opcional)
CARGO_VIP=1234567890123456789

# ============================================================
# 💳 GATEWAY DE PAGAMENTO (PIX MERCADO PAGO)
# ============================================================
# Token de Produção do Mercado Pago (Credenciais -> Access Token: APP_USR-...)
# NOTA MULTI-TENANT: Servidores individuais podem configurar seus próprios tokens
# diretamente pelo Discord com o comando: /configurar mercadopago definir token:<APP_USR-...>
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxx

# Modo de Simulação ('true' para testar aprovação instantânea sem dinheiro real, 'false' para Mercado Pago Real)
SIMULATION_MODE=false

# ============================================================
# 🔑 LICENCIAMENTO E SEGURANÇA (ANTI-PIRATARIA)
# ============================================================
# Chave de licença fornecida ao comprador (LIC-...)
# Se você é o desenvolvedor ou está em testes locais, pode usar DEV_MODE ou deixar em branco
LICENSE_KEY=DEV_MODE

# (Opcional) Bypass de licença para testes locais ('true' ou 'false')
BYPASS_LICENSE=true

# (Opcional) Whitelist de servidores Discord autorizados separados por vírgula
AUTHORIZED_GUILDS=*
